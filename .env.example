# ============================================================
# Ganitopia — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ============================================================

# -------- Firebase Client (public — safe to expose) --------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -------- Firebase Admin (server-only — NEVER expose) -------
# Get from Firebase Console → Project Settings → Service Accounts → Generate key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key including -----BEGIN/END----- lines.
# In .env.local, replace newlines with \n (literal backslash-n).
FIREBASE_ADMIN_PRIVATE_KEY=

# -------- Razorpay (server-only except KEY_ID) ---------------
# Start with rzp_test_ keys; switch to rzp_live_ when going live
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -------- Site -----------------------------------------------
NEXT_PUBLIC_SITE_URL=https://ganitopia.pages.dev
