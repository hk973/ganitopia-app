rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verify admin custom claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Helper: authenticated user
    function isAuth() {
      return request.auth != null;
    }

    // Users: owner reads/writes own profile; admin can read/update all
    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid || isAdmin();
      allow delete: if isAdmin();
    }

    // Purchases: owner reads, backend writes only (Admin SDK bypasses rules)
    match /purchases/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow write: if false; // Only backend via Firebase Admin SDK
    }

    // Payments: owner reads own, admin reads all; write only by backend
    match /payments/{orderId} {
      allow read: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow write: if false; // Only backend via Firebase Admin SDK
    }

    // Payment settings: anyone can read (for pricing page), admin writes
    match /paymentSettings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons: backend reads for validation, admin writes
    match /coupons/{code} {
      allow read: if false; // Only backend via Admin SDK
      allow write: if isAdmin();
    }

    // Student progress: owner reads and writes own progress only
    match /studentProgress/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // Visitor analytics: write-only for tracking (no PII), admin reads
    match /visitorAnalytics/{date} {
      allow read: if isAdmin();
      allow create, update: if true; // Anonymous tracking allowed
      allow delete: if isAdmin();
    }

    // Sessions subcollection under visitor analytics
    match /visitorAnalytics/{date}/sessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if true;
    }

    // Admin config: admin only
    match /adminConfig/{doc} {
      allow read, write: if isAdmin();
    }

    // Admin settings: admin only
    match /adminSettings/{doc} {
      allow read, write: if isAdmin();
    }

    // Activity logs: admin reads, owner can write own
    match /activityLogs/{uid} {
      allow read: if isAdmin() || request.auth.uid == uid;
      allow write: if request.auth.uid == uid;
    }
  }
}
