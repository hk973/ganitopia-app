{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./tmp/scripts",
    "esModuleInterop": true,
    "noEmit": false,
    "target": "ES2020"
  },
  "include": ["scripts/**/*", "lib/**/*", "data/**/*"],
  "exclude": ["node_modules", ".next"]
}
